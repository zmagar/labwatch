# Copy to .env and fill in. .env is gitignored — keep it that way.

# private | public | demo
# demo serves fixture data and never contacts real infrastructure.
LABWATCH_PROFILE=demo

LABWATCH_ADDR=:8080
LABWATCH_POLL_INTERVAL=30s

# --- Proxmox ---
# Create a dedicated API token with the PVEAuditor role and privilege
# separation enabled. Read-only, scoped, revocable without touching any
# account password.
PROXMOX_URL=https://proxmox.example:8006
PROXMOX_TOKEN_ID=labwatch@pve!dashboard
PROXMOX_TOKEN_SECRET=

# Proxmox ships a self-signed certificate. Set true only on a trusted
# network, and never silently — the collector must log when it is on.
PROXMOX_INSECURE_TLS=false

# --- Docker ---
# Points at the socket proxy, never at /var/run/docker.sock directly.
DOCKER_HOST=tcp://socket-proxy:2375
